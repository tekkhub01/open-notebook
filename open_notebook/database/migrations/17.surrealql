-- Migration 17: chunk-level vector search
-- Adds fn::vector_search_chunks that returns one row per source_embedding
-- match (instead of collapsing all chunks of a source into one row like
-- fn::vector_search does). Used by the RAG pipeline to emit chunk-level
-- citations such as `source:<parent>_chunk_<order>`.
--
-- Insight and note rows pass through unchanged — they're already
-- "fine-grained enough" (one record = one logical citation target).

DEFINE FUNCTION IF NOT EXISTS fn::vector_search_chunks(
    $query: array<float>,
    $match_count: int,
    $sources: bool,
    $show_notes: bool,
    $min_similarity: float,
    $notebook_id: option<record<notebook>>
) {
    let $notebook_source_ids = IF $notebook_id != NONE {
        (SELECT VALUE in FROM reference WHERE out = $notebook_id)
    } ELSE { NONE };

    let $notebook_note_ids = IF $notebook_id != NONE {
        (SELECT VALUE in FROM artifact WHERE out = $notebook_id)
    } ELSE { NONE };

    -- Chunk-level: id stays as source_embedding:xxx, parent_id points to source:yyy,
    -- and `order` (chunk sequence number) is propagated.
    let $source_embedding_search =
        IF $sources {(
            SELECT
                id,
                source.id as parent_id,
                source.title as title,
                content,
                order,
                vector::similarity::cosine(embedding, $query) as similarity
            FROM source_embedding
            WHERE embedding != none AND array::len(embedding) = array::len($query) AND
                 vector::similarity::cosine(embedding, $query) >= $min_similarity AND
                 ($notebook_source_ids IS NONE OR source IN $notebook_source_ids)
            ORDER BY similarity DESC
            LIMIT $match_count
        )}
        ELSE { [] };

    let $source_insight_search =
        IF $sources {(
            SELECT
                id,
                source.id as parent_id,
                insight_type + ' - ' + (source.title OR '') as title,
                content,
                NONE as order,
                vector::similarity::cosine(embedding, $query) as similarity
            FROM source_insight
            WHERE embedding != none AND array::len(embedding) = array::len($query) AND
                vector::similarity::cosine(embedding, $query) >= $min_similarity AND
                ($notebook_source_ids IS NONE OR source IN $notebook_source_ids)
            ORDER BY similarity DESC
            LIMIT $match_count
        )}
        ELSE { [] };

    let $note_content_search =
        IF $show_notes {(
            SELECT
                id,
                id as parent_id,
                title,
                content,
                NONE as order,
                vector::similarity::cosine(embedding, $query) as similarity
            FROM note
            WHERE embedding != none AND array::len(embedding) = array::len($query) AND
                vector::similarity::cosine(embedding, $query) >= $min_similarity AND
                ($notebook_note_ids IS NONE OR id IN $notebook_note_ids)
            ORDER BY similarity DESC
            LIMIT $match_count
        )}
        ELSE { [] };

    let $all_results = array::union(
        array::union($source_embedding_search, $source_insight_search),
        $note_content_search
    );

    RETURN (SELECT id, parent_id, title, content, order, similarity
            FROM $all_results
            WHERE id IS NOT None
            ORDER BY similarity DESC
            LIMIT $match_count);
};
